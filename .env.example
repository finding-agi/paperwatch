# Wallet that owns the Papertrade account. The address is enough for `run`.
PT_WALLET_ADDRESS=
# Only needed for `npm run session` (registers the 30-day trading key). Use a dedicated wallet; never commit this file.
PT_WALLET_PRIVATE_KEY=
# Deployed only: the trading key from .secrets/session-key.json, so the wallet key above stays on your machine
PT_SESSION_PRIVATE_KEY=
# Deployed only: dry (default) or live
PT_MODE=dry

# Strategy (defaults shown)
PT_INSTRUMENT=ETH
PT_LEG_NOTIONAL_USD=1000
PT_LEVERAGE=25
# Close and reopen the pair once either leg is this far against its entry (0.005 = 0.5%)
PT_RESET_MOVE=0.005
# pair: the reset above. spread: close and reopen just a leg that is PT_RESTRIKE_MOVE against its own entry,
# and close both legs once either is PT_TAKE_MOVE in profit (PT_RESET_MOVE is then unused)
PT_STRATEGY=pair
PT_RESTRIKE_MOVE=0.001
PT_TAKE_MOVE=0.004
PT_MAX_PAIRS=1
# Close the pair if any leg gets this close to its bust price
PT_MIN_BUST_DISTANCE=0.003
# Flatten and stop opening when the estimated move that would empty the LP drops below this
PT_QUEUE_GUARD_MOVE=0.03
# Stop opening new pairs once realized haircut cost today (UTC) reaches this
PT_MAX_DAILY_COST_USD=15
PT_TICK_MS=2000
# Live mode: close the bot's pairs on Ctrl-C (set 0 to leave them open)
PT_CLOSE_ON_EXIT=1

# Watcher (npm run watch)
# Discord/Slack-style incoming webhook for alerts (optional)
PT_ALERT_WEBHOOK_URL=
# Also pop macOS notifications (1/0)
PT_ALERT_DESKTOP=1
# If the live bot's heartbeat is older than this many seconds while its legs are open, the watcher closes them (0 = never)
PT_WATCH_AUTOCLOSE_SEC=120

# Trigger opens (npm run trigger, or a Railway service with PT_PROCESS=trigger)
# Required when deployed or live: random strings of 32+ characters. AUTH signs the sign-in cookies; KEY encrypts the
# visitors' Papertrade trading keys at rest. Changing KEY makes every stored key unusable (users enable trading again).
PT_AUTH_SECRET=
PT_KEY_SECRET=
# Hold a triggered order while the relayer has this many intents queued or more
PT_TRIGGER_MAX_QUEUED=250
